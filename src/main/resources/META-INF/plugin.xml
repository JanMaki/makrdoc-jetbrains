<idea-plugin>
    <id>com.github.markdoc.jetbrains</id>
    <name>Markdoc Language Service</name>
    <vendor>JanMaki</vendor>

    <description><![CDATA[
    <p><b>Requires a JetBrains IDE 2026.1.4 or later with Node.js support.</b></p>
    <p>Unofficial Markdoc integration built on the official
    <a href="https://github.com/markdoc/language-server">@markdoc/language-server</a>:
    tag and attribute completion, schema validation and syntax errors for
    <code>.mdoc</code>, <code>.markdoc</code> and <code>*.markdoc.md</code> files.</p>
    <p>This plugin is not affiliated with Stripe or the Markdoc project.</p>
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <depends>NodeJS</depends>
    <!-- LSP API を持たない IDE でも、ファイルタイプの関連付けだけは動くように optional にする -->
    <depends optional="true" config-file="lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 独自のファイルタイプは作らず、既存の Markdown ファイルタイプに拡張子を追加する -->
        <fileType name="Markdown" extensions="mdoc;markdoc" patterns="*.markdoc.md"/>
        <typedHandler implementation="com.github.markdoc.jetbrains.MarkdocTypedHandler"/>
        <!-- タグの色分け。Markdown ファイルのうち Markdoc ファイルだけを対象にする -->
        <annotator language="Markdown"
                   implementationClass="com.github.markdoc.jetbrains.highlighting.MarkdocTagAnnotator"/>
        <!-- タグの中の `$a["key"]` などを Markdown が参照リンクとして扱うため、その色（フィルター）と
             インスペクションの警告（サプレッサー）をタグの中だけ除く -->
        <daemon.highlightInfoFilter
                implementation="com.github.markdoc.jetbrains.highlighting.MarkdocTagHighlightFilter"/>
        <lang.inspectionSuppressor language="Markdown"
                                   implementationClass="com.github.markdoc.jetbrains.highlighting.MarkdocTagInspectionSuppressor"/>
        <projectConfigurable parentId="language" instance="com.github.markdoc.jetbrains.settings.MarkdocConfigurable"
                             id="com.github.markdoc.jetbrains.settings" displayName="Markdoc"/>
        <colorSettingsPage implementation="com.github.markdoc.jetbrains.highlighting.MarkdocColorSettingsPage"/>
        <!-- Markdoc ファイルの Ctrl+B を、Markdown の太字の切り替えより「宣言へ移動」を優先させる -->
        <actionPromoter implementation="com.github.markdoc.jetbrains.MarkdocActionPromoter" order="last"/>
        <!-- 属性値のファイルパス（partial の file など）からの移動と補完 -->
        <gotoDeclarationHandler implementation="com.github.markdoc.jetbrains.paths.MarkdocPathGotoDeclarationHandler"/>
        <!-- パスの中ではほかの補完を止めるため、先に動かす -->
        <completion.contributor language="Markdown" order="first"
                                implementationClass="com.github.markdoc.jetbrains.paths.MarkdocPathCompletionContributor"/>
    </extensions>
</idea-plugin>
