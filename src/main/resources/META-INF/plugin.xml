<idea-plugin>
    <id>net.plalis.markdoc</id>
    <name>Markdoc Language Service</name>
    <vendor>JanMaki</vendor>

    <description><![CDATA[
    <p><b>Requires a JetBrains IDE 2026.1.4 or later with Node.js support.</b></p>
    <p>Unofficial Markdoc integration built on the official
    <a href="https://github.com/markdoc/language-server">@markdoc/language-server</a>:
    tag and attribute completion, schema validation and syntax errors for
    <code>.mdoc</code>, <code>.markdoc</code> and <code>*.markdoc.md</code> files.</p>
    <p>This plugin is not affiliated with Stripe or the Markdoc project.</p>
  ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.intellij.plugins.markdown</depends>
    <depends>NodeJS</depends>
    <!-- LSP API を持たない IDE でも、ファイルタイプの関連付けだけは動くように optional にする -->
    <depends optional="true" config-file="lsp.xml">com.intellij.modules.lsp</depends>
    <!-- markdoc.config.json の補完と検査（JSON スキーマ）。JSON プラグインがない IDE では使わない -->
    <depends optional="true" config-file="json.xml">com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 独自のファイルタイプは作らず、既存の Markdown ファイルタイプに拡張子を追加する -->
        <fileType name="Markdown" extensions="mdoc;markdoc" patterns="*.markdoc.md"/>
        <typedHandler implementation="net.plalis.markdoc.MarkdocTypedHandler"/>
        <!-- タグの色分け。Markdown ファイルのうち Markdoc ファイルだけを対象にする -->
        <annotator language="Markdown"
                   implementationClass="net.plalis.markdoc.highlighting.MarkdocTagAnnotator"/>
        <!-- タグの中の `$a["key"]` などを Markdown が参照リンクとして扱うため、その色（フィルター）と
             インスペクションの警告（サプレッサー）をタグの中だけ除く -->
        <daemon.highlightInfoFilter
                implementation="net.plalis.markdoc.highlighting.MarkdocTagHighlightFilter"/>
        <lang.inspectionSuppressor language="Markdown"
                                   implementationClass="net.plalis.markdoc.highlighting.MarkdocTagInspectionSuppressor"/>
        <projectConfigurable parentId="language" instance="net.plalis.markdoc.settings.MarkdocConfigurable"
                             id="net.plalis.markdoc.settings" displayName="Markdoc"/>
        <colorSettingsPage implementation="net.plalis.markdoc.highlighting.MarkdocColorSettingsPage"/>
        <!-- Markdoc ファイルの Ctrl+B を、Markdown の太字の切り替えより「宣言へ移動」を優先させる -->
        <actionPromoter implementation="net.plalis.markdoc.MarkdocActionPromoter" order="last"/>
        <!-- 属性値のファイルパス（partial の file など）からの移動と補完 -->
        <gotoDeclarationHandler implementation="net.plalis.markdoc.paths.MarkdocPathGotoDeclarationHandler"/>
        <!-- パスの中ではほかの補完を止めるため、先に動かす -->
        <completion.contributor language="Markdown" order="first"
                                implementationClass="net.plalis.markdoc.paths.MarkdocPathCompletionContributor"/>
        <!-- 設定ファイルがないときに、作成を勧める通知を出す -->
        <notificationGroup id="Markdoc" displayType="BALLOON"/>
        <postStartupActivity implementation="net.plalis.markdoc.config.MarkdocConfigStartup"/>
    </extensions>

    <actions>
        <!-- New メニューから公式 README の例の中身で設定ファイルを作る -->
        <action id="Markdoc.NewConfigFile"
                class="net.plalis.markdoc.config.NewMarkdocConfigAction"
                text="Markdoc Config File"
                description="Create markdoc.config.json from the example configuration"
                icon="AllIcons.FileTypes.Json">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
